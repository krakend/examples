{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 4,
  "name": "KrakenD - Prompt Guard",
  "port": 8080,
  "host": [
    "http://fakeapi:8088"
  ],
  "debug_endpoint": true,
  "extra_config": {
    "ai/prompt-guard": {
      "guards": [
        {
          "name": "email",
          "kind": "regex",
          "severity": "high",
          "config": {
            "patterns": [
              "(\\s+|'|\"|^)[\\w\\+-\\.]+@[\\w-]+\\.\\w+(\\s+|'|\"|$)"
            ]
          }
        },
        {
          "name": "id_card",
          "kind": "regex",
          "severity": "medium",
          "config": {
            "patterns": [
              "(\\s+|'|\"|^)\\d{6,8}-?\\w(\\s+|'|\"|$)",
              "(\\s+|'|\"|^)X\\d{6,8}-?\\w(\\s+|'|\"|$)"
            ]
          }
        },
        {
          "name": "random_scorer",
          "kind": "classifier",
          "severity": "high",
          "config": {
            "score_threshold": 0.6,
            "on_failure_block": true,
            "url": "http://fakeapi:8088/scorer/"
          }
        },
        {
          "name": "failing_scorer",
          "kind": "classifier",
          "severity": "high",
          "config": {
            "score_threshold": 0.6,
            "on_failure_block": false,
            "url": "https://nonexistinglongdomainexample.com"
          }
        },
        {
          "name": "max_size_policy",
          "kind": "policy",
          "severity": "medium",
          "config": {
            "expressions": [
              "meta.something in [\"BENIGN\"]",
              "size(body) > 256"
            ]
          }
        }
      ]
    },
    "telemetry/opentelemetry": {
      "service_name": "krakend_prompt_guard",
      "metric_reporting_period": 5,
      "trace_sample_rate": 1,
      "exporters": {
        "prometheus": [
          {
            "name": "local_promoetheus",
            "port": 9090,
            "process_metrics": true,
            "go_metrics": true
          }
        ],
        "otlp": [
          {
            "name": "eleven_seconds",
            "host": "jaeger",
            "port": 4317,
            "disable_metrics": true,
            "disable_traces": false,
            "use_http": false,
            "custom_metric_reporting_period": 11
          }
        ]
      },
      "layers": {
        "global": {
          "disable_metrics": false,
          "disable_propagation": false,
          "disable_traces": false,
          "report_headers": true
        },
        "proxy": {
          "disable_metrics": false,
          "disable_traces": false,
          "report_headers": true
        },
        "backend": {
          "metrics": {
            "detailed_connection": true,
            "disable_stage": false,
            "read_payload": true,
            "round_trip": true
          },
          "traces": {
            "detailed_connection": true,
            "disable_stage": false,
            "read_payload": true,
            "report_headers": true,
            "round_trip": true
          }
        }
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/regex/personal/at_endpoint/",
      "method": "POST",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "method": "POST",
          "url_pattern": "/data/"
        }
      ],
      "extra_config": {
        "ai/prompt-guard": {
          "guards": [
            "!all_defaults",
            "email",
            "id_card"
          ]
        }
      }
    },
    {
      "endpoint": "/personal/at_backend",
      "method": "POST",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "method": "POST",
          "url_pattern": "/data/",
          "extra_config": {
            "ai/prompt-guard": {
              "guards": [
                "!all_defaults",
                "email",
                "id_card"
              ]
            }
          }
        }
      ]
    },
    {
      "endpoint": "/classifier/random",
      "method": "POST",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "method": "POST",
          "url_pattern": "/data/"
        }
      ],
      "extra_config": {
        "ai/prompt-guard": {
          "guards": [
            "!all_defaults",
            "random_scorer",
            "failing_scorer"
          ]
        }
      }
    },
    {
      "endpoint": "/policy/max_size",
      "method": "POST",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "method": "POST",
          "url_pattern": "/data/"
        }
      ],
      "extra_config": {
        "ai/prompt-guard": {
          "guards": [
            "!all_defaults",
            "max_size_policy"
          ]
        }
      }
    },
    {
      "endpoint": "/default_guards/",
      "method": "POST",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "method": "POST",
          "url_pattern": "/data/"
        }
      ],
      "extra_config": {
        "ai/prompt-guard": {
          "guards": []
        }
      }
    }
  ]
}
