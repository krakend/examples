{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 4,
  "name": "My first API Gateway - KrakenD",
  "port": 8080,
  "host": [
    "http://fakeapi:8088"
  ],
  "debug_endpoint": true,
  "extra_config": {
    "plugin": {
      "pattern": ".so",
      "folder": "/etc/krakend/plugins"
    },
    "plugin/http-server": {
      "plugins": [
        {
          "name": "otel-handler",
          "config": {
            "option": "server_option"
          }
        }
      ]
    },
    "telemetry/opentelemetry": {
      "service_name": "krakend_my_service",
      "metric_reporting_period": 5,
      "trace_sample_rate": 1,
      "exporters": {
        "otlp": [
          {
            "name": "datadog_five_seconds",
            "host": "http://ddcollector",
            "port": 4317,
            "disable_metrics": false,
            "disable_traces": false,
            "use_http": false
          },
          {
            "name": "eleven_seconds",
            "host": "jaeger",
            "port": 4317,
            "disable_metrics": true,
            "disable_traces": false,
            "use_http": false,
            "custom_metric_reporting_period": 11
          }
        ]
      },
      "layers": {
        "global": {
          "disable_metrics": false,
          "disable_propagation": false,
          "disable_traces": false,
          "report_headers": true
        },
        "proxy": {
          "disable_metrics": false,
          "disable_traces": false,
          "report_headers": true
        },
        "backend": {
          "metrics": {
            "detailed_connection": true,
            "disable_stage": false,
            "read_payload": true,
            "round_trip": true
          },
          "traces": {
            "detailed_connection": true,
            "disable_stage": false,
            "read_payload": true,
            "report_headers": true,
            "round_trip": true
          }
        }
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/dashboard",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "url_pattern": "/customer.json"
        },
        {
          "url_pattern": "/sales.json"
        }
      ]
    },
    {
      "endpoint": "/otelplugins",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "extra_config": {
        "plugin/req-resp-modifier": {
          "plugins": [
            {
              "name": "otel-modifier-request",
              "config": {
                "option": "endpoint_option"
              }
            }
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/customer.json",
          "extra_config": {
            "plugin/req-resp-modifier": {
              "plugins": [
                {
                  "name": "otel-modifier-response",
                  "config": {
                    "option": "backend_option"
                  }
                }
              ]
            }
          }
        },
        {
          "url_pattern": "/sales.json",
          "extra_config": {
            "plugin/http-client": {
              "name": "otel-client",
              "config": {
                "option": "something"
              }
            }
          }
        }
      ]
    }
  ]
}
