{
  "$schema": "https://krakend.io/schema/krakend.json",
  "version": 4,
  "host": [
    "http://localhost:8080"
  ],
  "echo_endpoint": true,
  "debug_endpoint": true,
  "extra_config": {
    "plugin": {
      "folder": "/opt/krakend/plugins/",
      "pattern": ".so"
    },
    "redis": {
      "connection_pools": [
        {
          "address": "redis:6379",
          "name": "local_instance",
          "db": 1
        }
      ]
    }
  },
  "endpoints": [
    {
      "endpoint": "/",
      "backend": [
        {
          "url_pattern": "/__echo/"
        }
      ],
      "extra_config": {
        "plugin/middleware": {
          "plugins": [
            {
              "name": "counter-example-mw",
              "config": {
                "key_prefix": "foo-counter"
              }
            }
          ]
        }
      }
    }
  ]
}
