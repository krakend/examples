          },
          {
            "matcher": {
              "id": "byName",
              "options": "💣 Bombs"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff2bd6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "processor",
            "rowField": "user",
            "valueField": "Sum",
            "emptyValue": "zero"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "alias": "Score",
            "reduce": {
              "reducer": "sum",
              "include": [
                "weapon_power_up",
                "bomb_reload"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Score",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "user\\processor": 0,
              "Score": 1,
              "weapon_power_up": 2,
              "bomb_reload": 3
            },
            "renameByName": {
              "user\\processor": "Pilot",
              "weapon_power_up": "⚡ Power-ups",
              "bomb_reload": "💣 Bombs",
              "Score": "★ Score"
            }
          }
        }
      ]
    },
