{
  "uid": "earth-vs-aliens",
  "title": "Earth vs Aliens: Mission Control",
  "description": "Quota consumption of the Earth vs Aliens game, built from KrakenD quota events",
  "tags": [
    "krakend",
    "quota",
    "governance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Window",
        "type": "custom",
        "query": "hour,day",
        "current": {
          "text": "hour",
          "value": "hour"
        },
        "options": [
          {
            "text": "hour",
            "value": "hour",
            "selected": true
          },
          {
            "text": "day",
            "value": "day",
            "selected": false
          }
        ],
        "description": "Each quota limit emits its own events: pick which limit window to count"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"text-align:center;font-family:'Courier New',monospace;background:radial-gradient(ellipse at center,#1a0040 0%,#07001a 75%);border:2px solid #ff2bd6;box-shadow:0 0 14px #ff2bd6,inset 0 0 24px #2a0066;padding:10px 8px;border-radius:8px\">\n<div style=\"font-size:36px;font-weight:900;letter-spacing:8px;color:#00e5ff;text-shadow:0 0 6px #00e5ff,0 0 18px #00e5ff\">EARTH <span style=\"color:#ff2bd6;text-shadow:0 0 6px #ff2bd6,0 0 18px #ff2bd6\">vs</span> ALIENS</div>\n<div style=\"margin-top:4px;color:#ffe600;letter-spacing:4px;font-size:13px;text-shadow:0 0 6px #ffe600\">★ MISSION CONTROL ★ LIVE QUOTA EVENTS FROM KRAKEND ★ INSERT COIN ★</div>\n</div>"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "🪙 Coins inserted",
      "description": "Credits consumed (quota: credits)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "quota-es"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "quota-es"
          },
          "query": "event:\"quota.limit.increment\" AND unit:$window AND processor:credits",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "weight"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#ffe600"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      }
    },
